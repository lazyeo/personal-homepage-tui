<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="hero-kicker">Shaun Zhang</p>
    <h1 id="hero-title">
      Product-minded <em><span class="nowrap">full-stack</span> developer.</em>
    </h1>
    <p class="hero-stack">
      C#/.NET · TypeScript · Java (Android) · AI-agent workflows
    </p>
    <p class="hero-value">
      I turn messy business needs into shipped, tested software. I use AI
      agents to build faster, with specs, tests and on-device checks before
      anything ships.
    </p>
    <ul class="hero-facts" aria-label="At a glance">
      <li>Christchurch, NZ</li>
      <li>Full work rights in NZ</li>
      <li>Open to software, AI and BA roles</li>
    </ul>
    <div class="hero-actions">
      <a class="button" href="#work">Explore my work <span aria-hidden="true">↘&#xFE0E;</span></a>
      <a class="button button-quiet" href="mailto:shaun@a-dobe.club">Email</a>
      <a
        class="button button-quiet"
        href="https://www.linkedin.com/in/shaun-nz/"
        target="_blank"
        rel="noopener noreferrer">LinkedIn</a
      >
      <a
        class="button button-quiet"
        href="https://github.com/lazyeo"
        target="_blank"
        rel="noopener noreferrer">GitHub</a
      >
    </div>
  </div>
  <div class="computer-stage" id="computer-stage">
    <div class="orbit-label">A small window into my world.</div><a
      class="computer"
      id="computer"
      href="/terminal"
      data-terminal
      aria-label="Open the interactive terminal to ask about Shaun's work"
      ><div class="monitor">
        <div class="monitor-side"></div><div class="monitor-front">
          <div class="screen">
            <div class="screen-top">
              <span>shaun@portfolio</span><span>~</span>
            </div><div class="screen-content">
              <span class="screen-greeting">Hello, curious human.</span><p>
                Good things start<br />with a conversation.
              </p><div class="screen-prompt">
                <span>&gt;</span> ask me anything<span class="cursor">_</span>
              </div>
            </div><div class="screen-bottom">
              <span>PRODUCT THINKING × BUILDING</span><span>↗&#xFE0E;</span>
            </div>
          </div><div class="monitor-chin">
            <span class="computer-brand">s.</span><span class="power-light"
            ></span>
          </div>
        </div>
      </div><div class="monitor-neck"></div><div class="monitor-foot"></div><div
        class="keyboard"
      >
        <div class="keys">
          {
            Array.from({ length: 36 }, (_, i) => (
              <span class={i === 32 ? "space-key" : ""} />
            ))
          }
        </div>
      </div></a
    ><div class="desk-shadow"></div><div class="computer-caption">
      <span class="caption-line"></span><a
        class="caption-button"
        href="/terminal"
        data-terminal
        aria-label="Open the interactive terminal"
        >Go on, say hello.<span class="caption-arrow" aria-hidden="true">↗&#xFE0E;</span
        ></a
      >
    </div>
  </div><div class="hero-bottom">
    <span class="hero-slogan">Thoughtful ideas. <em>Useful things.</em></span><span
      >SELECTED WORK BELOW ↓</span
    >
  </div>
</section>
