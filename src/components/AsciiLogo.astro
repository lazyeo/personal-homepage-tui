---
import GithubHeatmap from './GithubHeatmap.astro';

// ASCII Logo - Desktop uses Unicode block style, Mobile uses pure ASCII
const asciiLogoDesktop = `
███████╗██╗  ██╗ █████╗ ██╗   ██╗███╗   ██╗
██╔════╝██║  ██║██╔══██╗██║   ██║████╗  ██║
███████╗███████║███████║██║   ██║██╔██╗ ██║
╚════██║██╔══██║██╔══██║██║   ██║██║╚██╗██║
███████║██║  ██║██║  ██║╚██████╔╝██║ ╚████║
╚══════╝╚═╝  ╚═╝╚═╝  ╚═╝ ╚═════╝ ╚═╝  ╚═══╝
`.trim();

// Mobile: Pure ASCII only (no Unicode box-drawing)
const asciiLogoMobile = `
 #####   #   #   #   #   # #   #
#       #   #  # #  #   # ##  #
 ####   ##### #   # #   # # # #
     #  #   # ##### #   # #  ##
#####   #   # #   #  ###  #   #

`.trim();

const tagline = "Christchurch · Product-Minded Vibe Coder";
---

<div class="ascii-header">
  <div class="ascii-header__row">
    <div class="ascii-header__logo">
      <pre class="ascii-logo ascii-logo--desktop" aria-label="SHAUN">{asciiLogoDesktop}</pre>
      <pre class="ascii-logo ascii-logo--mobile" aria-label="SHAUN">{asciiLogoMobile}</pre>
    </div>
    <div class="ascii-header__heatmap">
      <GithubHeatmap username="lazyeo" />
    </div>
  </div>
  <p class="brand-tagline">{tagline}</p>
</div>

<style>
  .ascii-header {
    text-align: left;
    /* The terminal also renders inside a ~680px drawer on desktop, where a
       viewport breakpoint wrongly reports "mobile". Ask the container. */
    container-type: inline-size;
  }

  .ascii-header__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    margin-bottom: 0.5rem;
  }

  .ascii-header__logo {
    flex-shrink: 0;
  }

  .ascii-header__heatmap {
    flex: 1;
    max-width: 280px;
  }

  .ascii-logo--mobile {
    display: none;
  }

  /* Solid block characters need their rows to touch, or the letters read as
     stripes. The hash logo is open by design and keeps the base line height. */
  .ascii-logo--desktop {
    line-height: 1;
  }

  /* Both logos are measured to fit at every width, and overflow-x: auto would
     promote overflow-y to auto as well, reserving scrollbar gutters around art
     that never scrolls. */
  .ascii-logo--desktop,
  .ascii-logo--mobile {
    overflow: visible;
  }

  /* Logo 254px + heatmap 280px + gap: below this they stop fitting side by side. */
  @container (max-width: 580px) {
    .ascii-header__row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .ascii-header__heatmap {
      width: 100%;
      max-width: unset;
    }
  }

  /* The block letters are not in the loaded webfont, so each one is substituted
     from a system font whose advance width may not match. That drift is what
     misaligns them on phones, so keep the pure-ASCII logo for narrow screens.
     Width is not the reason: the block version measures 254px. */
  @container (max-width: 420px) {
    .ascii-logo--desktop {
      display: none;
    }
    .ascii-logo--mobile {
      display: block;
      font-size: 0.6rem;
      line-height: 1.2;
    }
  }
</style>
