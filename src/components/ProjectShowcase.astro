---
import { projects } from "../data/projects";
import ProjectVisual from "./ProjectVisual.astro";
import "../styles/project-showcase.css";
// Every selected project is visible without interaction: a visitor scanning
// for thirty seconds should not have to find a Next button to see the
// strongest work. Order and copy live in src/data/projects.ts.
---

<section class="work-section wrap" id="work" aria-labelledby="work-title">
  <div class="section-heading">
    <h2 id="work-title">Selected <em>work.</em></h2><p>
      What each project is, what I did, and something you can check.
    </p>
  </div>
  <ol class="work-list">
    {
      projects.map((project, i) => (
        <li
          class:list={["work-card", { "work-card--lead": i === 0 }]}
          id={`project-${project.slug}`}
        >
          <article aria-labelledby={`title-${project.slug}`}>
            <div class="work-visual">
              <ProjectVisual slug={project.slug} />
            </div>
            <div class="work-body">
              <p class="work-category">{project.category}</p>
              <h3 id={`title-${project.slug}`}>{project.name}</h3>
              <p class="work-tagline">{project.tagline}</p>
              <p class="work-summary">{project.summary}</p>
              <dl class="work-facts">
                <div>
                  <dt>My role</dt>
                  <dd>{project.role}</dd>
                </div>
                <div>
                  <dt>Result</dt>
                  <dd>{project.proof}</dd>
                </div>
              </dl>
              <ul class="work-stack" aria-label="Technologies">
                {project.stack.split(" · ").map((tag) => <li>{tag}</li>)}
              </ul>
              <div class="work-actions">
                <a class="button" href={`/work/${project.slug}/`}>
                  Case study<span class="visually-hidden">: {project.name}</span>
                </a>
                {project.link && (
                  <a
                    class="button button-quiet"
                    href={project.link}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {project.linkLabel ?? "Visit the website"} ↗&#xFE0E;
                  </a>
                )}
                {project.repo && (
                  <a
                    class="button button-quiet"
                    href={project.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Source on GitHub ↗&#xFE0E;
                  </a>
                )}
              </div>
            </div>
          </article>
        </li>
      ))
    }
  </ol>
</section>
