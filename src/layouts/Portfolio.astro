---
import "../styles/portfolio.css";
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Shaun Zhang — Product-minded full-stack developer, Christchurch NZ",
  description = "Shaun Zhang is a product-minded full-stack developer in Christchurch, New Zealand: C#/.NET, TypeScript, Java (Android) and AI-agent workflows. Full work rights in NZ; open to software, AI and BA roles.",
} = Astro.props;
// On the homepage the section links stay in-page; elsewhere they lead back to it.
const home = Astro.url.pathname === "/" ? "" : "/";
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og-image.png", Astro.site).href;
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Shaun Zhang",
  alternateName: "Shun Zhang",
  jobTitle: "Product-minded full-stack developer",
  url: "https://hi.a-dobe.club/",
  email: "mailto:shaun@a-dobe.club",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Christchurch",
    addressCountry: "NZ",
  },
  alumniOf: { "@type": "CollegeOrUniversity", name: "Lincoln University" },
  knowsAbout: ["C#", ".NET", "TypeScript", "Java", "Android", "AI-agent workflows", "Business analysis"],
  sameAs: ["https://github.com/lazyeo", "https://www.linkedin.com/in/shaun-nz/"],
};
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta name="description" content={description} /><meta
      name="theme-color"
      content="#1d2021"
    /><link rel="canonical" href={canonical} /><meta
      property="og:type"
      content="website"
    /><meta property="og:url" content={canonical} /><meta
      property="og:site_name"
      content="Shaun Zhang"
    /><meta property="og:title" content={title} /><meta
      property="og:description"
      content={description}
    /><meta property="og:image" content={ogImage} /><meta
      property="og:image:width"
      content="1200"
    /><meta property="og:image:height" content="630" /><meta
      property="og:image:alt"
      content="Shaun Zhang, product-minded full-stack developer in Christchurch, New Zealand"
    /><meta name="twitter:card" content="summary_large_image" /><meta
      name="twitter:title"
      content={title}
    /><meta name="twitter:description" content={description} /><meta
      name="twitter:image"
      content={ogImage}
    /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link
      rel="preload"
      href="/fonts/dm-serif-display.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    /><script type="application/ld+json" set:html={JSON.stringify(person)} /><title
      >{title}</title
    ></head
  >
  <body
    ><a class="skip-link" href="#main">Skip to content</a><header
      class="site-header wrap"
    >
      <a class="wordmark" href="/" aria-label="Shaun Zhang, home"
        >shaun<span>.</span></a
      ><nav aria-label="Main navigation">
        <a href={`${home}#work`}>Work</a><a href={`${home}#experience`}
          >Experience</a
        ><a href={`${home}#contact`}>Contact</a>
      </nav><a class="terminal-link" href="/terminal" data-terminal
        ><span aria-hidden="true">&gt;_</span> Open terminal</a
      >
    </header>
    <main id="main"><slot /></main><footer class="site-footer wrap">
      <a class="wordmark" href="/">shaun<span>.</span></a><p>
        Made with curiosity. Built with care.
      </p><div>
        <a href="mailto:shaun@a-dobe.club">Email</a><a
          href="https://github.com/lazyeo"
          target="_blank"
          rel="noopener noreferrer">GitHub ↗&#xFE0E;</a
        ><a
          href="https://www.linkedin.com/in/shaun-nz/"
          target="_blank"
          rel="noopener noreferrer">LinkedIn ↗&#xFE0E;</a
        >
      </div><span>©&#xFE0E; {new Date().getFullYear()} Shaun Zhang</span>
    </footer>
    <dialog id="terminal-dialog" aria-labelledby="terminal-heading">
      <div class="dialog-bar">
        <h2 id="terminal-heading">A conversation with Shaun’s AI</h2><div
          class="terminal-controls"
        >
          <button id="expand-terminal" aria-pressed="false">Full screen</button
          ><button id="close-terminal" aria-label="Close terminal"
            >Close ×</button>
        </div>
      </div><p class="terminal-note">
        Ask about my work, or explore with /projects.
      </p><div id="terminal-frame-slot"></div>
    </dialog>
    <script src="../scripts/portfolio.ts"></script></body
  >
</html>
