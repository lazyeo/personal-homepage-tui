---
interface Props {
  title?: string;
}

const { title = "Shaun | Product-Minded Vibe Coder" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Shaun - Product-Minded Vibe Coder based in Christchurch, New Zealand" />
    <meta name="theme-color" content="#1d2021" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- As @import inside tui.css these were only discovered once that
      stylesheet had downloaded and parsed, which put the request 368ms into
      the load and left first paint waiting on the round trip. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
    <!-- Box drawing and block elements are dropped by the default subsets. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono&text=%20%E2%96%88%E2%95%90%E2%95%91%E2%95%94%E2%95%97%E2%95%9A%E2%95%9D&display=swap"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      // Initialize theme from localStorage or default to gruvbox
      const savedTheme = localStorage.getItem('theme') || 'gruvbox';
      document.documentElement.setAttribute('data-theme', savedTheme);
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/themes.css';
  @import '../styles/tui.css';
</style>
