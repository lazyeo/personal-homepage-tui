---
interface Props {
  title?: string;
}

const { title = "Shaun | Product-Minded Vibe Coder" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Shaun - Product-Minded Vibe Coder based in Christchurch, New Zealand" />
    <meta name="theme-color" content="#1d2021" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <!-- External rather than inline so the site's CSP can forbid inline script. -->
    <script is:inline src="/scripts/terminal-theme.js"></script>
  </body>
</html>

<style is:global>
  @import '../styles/themes.css';
  @import '../styles/tui.css';
</style>
