---
import Portfolio from "../../layouts/Portfolio.astro";
import ProjectVisual from "../../components/ProjectVisual.astro";
import { projects } from "../../data/projects";
export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}
const { project } = Astro.props;
---

<Portfolio
  title={`${project.name} — Selected work by Shaun Zhang`}
  description={project.intro}
  ><article class="case-study wrap">
    <a class="text-link" href="/#work">← All work</a><div class="case-title">
      <h1>{project.name}</h1><p>{project.intro}</p>
    </div><div class="case-meta">
      <span>{project.category}</span><span>{project.stack}</span>{
        project.link && (
          <a href={project.link} target="_blank" rel="noopener noreferrer">
            Visit project ↗&#xFE0E;
          </a>
        )
      }
    </div>{
      project.slug === "ky01-launcher" ? (
        <div class="device-viewer">
          <iframe
            src="/ky01/?embed=1&screen=home&lang=en"
            title="Interactive 3D preview of the KY-01L running Pocket Home"
            loading="lazy"
          />
          <p>
            Drag to turn the device. The screen is a capture from the launcher
            running on the physical KY-01L, not a mock-up.
          </p>
        </div>
      ) : (
        <ProjectVisual slug={project.slug} />
      )
    }<div class="case-sections">
      {
        [
          ["The starting point", project.problem],
          ["My contribution", project.contribution],
          ["A key decision", project.decision],
          ["What came out of it", project.result],
        ].map(([heading, body]) => (
          <section>
            <>
              <h2>{heading}</h2>
              <p>{body}</p>
            </>
          </section>
        ))
      }
    </div><div class="case-end">
      <h2>There’s more to the story.</h2><a
        class="button"
        href="/terminal"
        data-terminal>Ask about my work ↗&#xFE0E;</a
      ><a class="text-link" href="mailto:shaun@a-dobe.club"
        >Talk to me directly ↗&#xFE0E;</a>
    </div>
  </article></Portfolio
>
