---
import Portfolio from "../layouts/Portfolio.astro";
import TerminalHero from "../components/TerminalHero.astro";
import ProjectShowcase from "../components/ProjectShowcase.astro";
---

<Portfolio title="Shaun Zhang — Ideas, in use" workHref="#work">
  <TerminalHero />
  <ProjectShowcase />
  <section class="contact-section wrap">
    <div>
      <h2>Something in mind?<br /><em>Let’s make it real.</em></h2><a
        class="contact-email"
        href="mailto:shaun@a-dobe.club">shaun@a-dobe.club</a>
    </div><div class="contact-aside">
      <p>Curious about how I work?<br />Start a conversation.</p><a
        class="text-link"
        href="/terminal"
        data-terminal>Ask my AI terminal</a
      >
    </div>
  </section>
</Portfolio>
